<?xml version="1.0" encoding="UTF-8"?>
<!--
    Sistema de Venta - configuracion de Logback (SLF4J).

    LOG_DIR es inyectada en tiempo de arranque por
    py.com.sistemaventa.logging.LoggingConfigurator.
-->
<configuration>

    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATTERN_CONSOLE" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
    <property name="PATTERN_FILE" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN_CONSOLE}</pattern>
        </encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sistema-venta.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/sistema-venta.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
        </encoder>
    </appender>

    <!--
        El nivel raiz es fijo en INFO como valor seguro por defecto.
        LoggingConfigurator lo ajusta segun 'logging.level' de
        application.properties.
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
